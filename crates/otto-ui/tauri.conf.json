{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otto",
  "version": "0.1.0",
  "identifier": "dev.ayimdomnic.otto",
  "build": {
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Otto",
        "width": 1200,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "bean-code",
    "homepage": "https://github.com/bean-code/otto",
    "copyright": "Copyright © 2026 bean-code",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Autopilot for your engineering workflow",
    "longDescription": "Otto is a personal automation assistant for engineers: a natural-language command bar that dispatches to typed integrations (GitHub PRs and CI today) via the Claude API, with local voice input/output, a working-hours schedule, and a queryable activity history.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "French", "German", "Spanish"],
        "displayLanguageSelector": true
      }
    }
  }
}
