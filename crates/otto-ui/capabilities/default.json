{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Otto window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-run-command",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-speak",
    "allow-list-activities",
    "allow-list-models",
    "allow-get-model",
    "allow-set-model",
    "allow-list-skills",
    "allow-get-greeting-name",
    "allow-get-credential-status",
    "allow-set-credential"
  ]
}
