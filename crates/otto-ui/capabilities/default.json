{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Otto window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-run-command",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-speak",
    "allow-list-activities",
    "allow-list-providers",
    "allow-list-models",
    "allow-get-selected-model",
    "allow-set-selected-model",
    "allow-list-skills",
    "allow-get-greeting-name",
    "allow-get-credential-status",
    "allow-set-credential",
    "allow-connect-google-calendar-cmd",
    "allow-list-profiles",
    "allow-get-current-profile",
    "allow-start-github-device-flow",
    "allow-sign-in-with-pat",
    "allow-switch-profile",
    "allow-sign-out",
    "allow-get-preferences",
    "allow-set-preferences"
  ]
}
